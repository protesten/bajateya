# Plantilla de configuración. Copia este fichero a `config/secrets.env`
# y rellena los valores reales. `secrets.env` está ignorado por git.

# Identificador de aplicación para los web services SAE de TITSA (tiempo real).
# Autorizado por TITSA para la fase de desarrollo.
TITSA_ID_APP=

# Base URL del servicio SAE de tiempo real.
TITSA_SAE_BASE=http://apps.titsa.com/apps

# URL del GTFS oficial (Cabildo de Tenerife, licencia CC-BY).
GTFS_URL=https://datos.tenerife.es/ckan/dataset/36c2e26f-0d18-4b5a-b214-1636168e0765/resource/9f291323-8b78-453a-9008-4f0e3bfb3ce3/download/fichero-zip-de-google-transit.zip

# Alojamiento de las versiones de datos en GitHub Releases (tag "gtfs").
# Sustituye OWNER/REPO por tu repositorio.
HOSTING_BASE=https://github.com/protesten/bajateya/releases/download/gtfs
DATA_MANIFEST_URL=https://github.com/protesten/bajateya/releases/download/gtfs/manifest.json
